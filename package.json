{
  "name": "flowdesk",
  "productName": "FlowDesk",
  "version": "1.0.0",
  "description": "Windows 本地效率工具 - 待办事项与灵感记录",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.flowdesk.desktop",
    "productName": "FlowDesk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/flowdesk.ico"
    },
    "portable": {
      "artifactName": "FlowDesk-${version}-portable-${arch}.${ext}",
      "useZip": true
    },
    "extraResources": [
      {
        "from": "resources/flowdesk.ico",
        "to": "flowdesk.ico"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "package:portable": "npm run build && electron-builder --win portable --x64",
    "preview": "vite preview",
    "test": "vitest run",
    "version:patch": "npm version patch --no-git-tag-version && git add package.json && git commit -m \"chore: bump version\"",
    "version:minor": "npm version minor --no-git-tag-version && git add package.json && git commit -m \"chore: bump minor version\"",
    "version:major": "npm version major --no-git-tag-version && git add package.json && git commit -m \"chore: bump major version\"",
    "release": "npm run version:patch && git tag v$(node -p \"require('./package.json').version\") && git push && git push --tags"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "dompurify": "^3.4.12",
    "markdown-it": "^14.3.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "26.0.12",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.0.0"
  }
}
