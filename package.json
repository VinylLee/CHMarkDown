{
  "name": "chmarkdown",
  "productName": "CHMarkDown",
  "version": "1.0.2",
  "description": "Windows 本地 Markdown 编辑与笔记工具",
  "author": "VinylLee",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.chmarkdown.desktop",
    "productName": "CHMarkDown",
    "artifactName": "CHMarkDown-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "compression": "store",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/chmarkdown.ico",
      "signExecutable": false
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "nsis": {
      "installerIcon": "resources/chmarkdown.ico"
    },
    "portable": {
      "artifactName": "CHMarkDown-${version}-portable-${arch}.${ext}",
      "useZip": true
    },
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "resources/chmarkdown.ico",
        "to": "chmarkdown.ico"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "package:portable": "npm run build && electron-builder --win portable --x64",
    "package:zip": "npm run build && electron-builder --win zip --x64 --config.compression=maximum",
    "measure:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-startup.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "version:patch": "npm version patch --no-git-tag-version && git add package.json && git commit -m \"chore: bump version\"",
    "version:minor": "npm version minor --no-git-tag-version && git add package.json && git commit -m \"chore: bump minor version\"",
    "version:major": "npm version major --no-git-tag-version && git add package.json && git commit -m \"chore: bump major version\"",
    "release": "npm run version:patch && git tag v$(node -p \"require('./package.json').version\") && git push && git push --tags"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "dompurify": "^3.4.12",
    "markdown-it": "^14.3.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.0"
  }
}
